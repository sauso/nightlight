# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
backend/public/

# Coverage reports (`npm run test:coverage` in backend/ or frontend/ writes a coverage/ folder).
coverage/

# vitest 5's --reporter=json writes here instead of stdout (breaks scripts/mutate.mjs's frontend
# runner — see that finding, filed separately). Not build output worth keeping either way.
frontend/.vitest/

# The restore journal of scripts/mutate.mjs (#599): exists only while a mutant is on disk, or after a run that
# was killed hard enough to skip its handlers. Machine-local state, never to be committed.
scripts/.mutate-restore.json
scripts/.mutate-restore.json.*.tmp

# Local data (SQLite DB, logs, MediaMTX runtime config) - never commit this
data/

# Environment secrets
.env

# OS/editor cruft
.DS_Store
*.log
.vscode/
.idea/

# ...but test fixtures are source, not cruft. `*.log` above silently swallowed a captured CI log used
# as a fixture: the test passed locally against an untracked file and went red the moment CI checked
# the branch out clean. Everything under a fixtures/ directory is committed on purpose.
!**/test/fixtures/**

# Firebase service-account credential — a secret, mounted into the data dir, never committed.
firebase-service-account.json
**/firebase-service-account.json
