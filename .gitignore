# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
backend/public/

# Local data (SQLite DB, logs, MediaMTX runtime config) - never commit this
data/

# Environment secrets
.env

# OS/editor cruft
.DS_Store
*.log
.vscode/
.idea/

# ...but test fixtures are source, not cruft. `*.log` above silently swallowed a captured CI log used
# as a fixture: the test passed locally against an untracked file and went red the moment CI checked
# the branch out clean. Everything under a fixtures/ directory is committed on purpose.
!**/test/fixtures/**

# Firebase service-account credential — a secret, mounted into the data dir, never committed.
firebase-service-account.json
**/firebase-service-account.json
