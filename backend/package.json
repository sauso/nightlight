{
  "name": "babymonitor-backend",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "test:core": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-include=src/db.js --test-coverage-include=src/middleware/auth.js --test-coverage-include=src/routes/auth.js --test-coverage-include=src/lib/mfa.js --test-coverage-include=src/lib/detectionEvents.js --test-coverage-include=src/routes/timelapses.js --test-coverage-include=src/lib/wakeWatcher.js --test-coverage-include=src/lib/activityTracker.js --test-coverage-include=src/lib/bedTransitions.js --test-coverage-include=src/lib/bedTransitionRules.js --test-coverage-include=src/lib/sleepAnalysis.js --test-coverage-include=src/lib/sleepReviews.js --test-coverage-include=src/lib/soundBaseline.js --test-coverage-include=src/lib/processGuards.js --test-coverage-include=src/lib/ringHolds.js --test-coverage-include=src/lib/urlCredentials.js test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "onvif": "^0.8.2",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  }
}
