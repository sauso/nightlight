{
  "name": "babymonitor-backend",
  "version": "0.47.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "test:future": "node --import ../scripts/clock-shift.mjs --experimental-test-module-mocks --test test/*.test.js",
    "test:core": "node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-include=src/lib/clientBucket.js --test-coverage-include=src/lib/alertHold.js --test-coverage-include=src/db.js --test-coverage-include=src/middleware/auth.js --test-coverage-include=src/routes/auth.js --test-coverage-include=src/lib/mfa.js --test-coverage-include=src/lib/accountThrottle.js --test-coverage-include=src/lib/detectionEvents.js --test-coverage-include=src/routes/timelapses.js --test-coverage-include=src/lib/wakeWatcher.js --test-coverage-include=src/lib/activityTracker.js --test-coverage-include=src/lib/bedTransitions.js --test-coverage-include=src/lib/bedTransitionRules.js --test-coverage-include=src/lib/bedTransitionTracker.js --test-coverage-include=src/lib/sleepAnalysis.js --test-coverage-include=src/lib/micGuard.js --test-coverage-include=src/lib/sleepSensor.js --test-coverage-include=src/lib/primaryCamera.js --test-coverage-include=src/lib/sleepReviews.js --test-coverage-include=src/lib/soundBaseline.js --test-coverage-include=src/lib/processGuards.js --test-coverage-include=src/lib/cameraWatchdogs.js --test-coverage-include=src/lib/audioLiveness.js --test-coverage-include=src/lib/ringHolds.js --test-coverage-include=src/lib/urlCredentials.js --test-coverage-include=src/lib/clipStorage.js --test-coverage-include=src/lib/clipCapture.js --test-coverage-include=src/lib/clipRecorder.js --test-coverage-include=src/lib/recordings.js --test-coverage-include=src/routes/recordings.js --test-coverage-include=src/lib/talkSocket.js --test-coverage-include=src/middleware/demoMode.js --test-coverage-include=src/middleware/whepOnlyGuard.js --test-coverage-include=src/lib/httpPath.js --test-coverage-include=src/lib/webrtcSessions.js --test-coverage-include=src/lib/logger.js --test-coverage-include=src/lib/processOutput.js --test-coverage-include=src/lib/ffmpegSideChannel.js --test-coverage-include=src/lib/observationClock.js --test-coverage-include=src/lib/mediaFiles.js --test-coverage-include=src/lib/mediaLayout.js test/*.test.js",
    "test:coverage": "node --experimental-test-module-mocks --test --experimental-test-coverage test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "1.4.4",
    "esphome-client": "2.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.16.1",
    "onvif": "^0.8.3",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.3",
    "ws": "^8.22.1"
  },
  "//": "overrides: issue #455. firebase-admin's OPTIONAL @google-cloud/storage still pulls gaxios 6, whose uuid ^9 matches GHSA-w5hq-g745-h8pq (npm audit fix cannot clear it). Scoped to gaxios 6 only: uuid 11 keeps CommonJS require() and the v4() gaxios calls; the override goes inert once storage moves to gaxios 7. Guarded by test/dependency-hygiene.test.js. Also rimraf (alerts #15 glob, #17 minimatch): google-gax 5 and gaxios 7.1 list rimraf 5 in their manifests but never require it (grep of their build output finds no use), and rimraf 5 pins glob 10 / minimatch 9, below the fixed 14.0.2 / 11.0.1; firestore 9.4.0 still pins firestore-api 0.2.0 which pulls google-gax 5, so no upgrade clears it. rimraf 6 uses glob 14. Remove this override when google-gax 5 leaves the tree.",
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "rimraf": "^6.1.4"
  }
}
