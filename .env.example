# Which host user/group owns files this container creates in the data volume
# (the database and secrets in its private/ folder, snapshots, clips). Defaults to 99/100 - Unraid's own
# "nobody"/"users" convention - so these are usually fine to leave as-is on Unraid.
# On other systems, find your own with: id your_username
PUID=99
PGID=100

# Who else may read what the container writes in the data volume. The database holds every
# stored secret (camera passwords, notification tokens) in plaintext, so the default 077 makes
# everything owner-only (files 600, folders 700) and each start takes group/other access off
# anything that still has it. Range: 3 or 4 octal digits with an owner digit of 0 (000-077 or
# 0000-0077). Blank = 077. Anything else is ignored with a warning in the log and 077 is used.
# Set 022 for the old world-readable modes if another user or container reads the data volume -
# and set it BEFORE upgrading: after one start at 077, 022 only affects new files. It never opens
# the volume's private/ folder (the database, secrets, snapshots and backups): that is always 700.
# See docs/operations.md, "Who can read the data directory".
UMASK=077

# Your local timezone, e.g. Australia/Melbourne - affects log timestamps and the names of the video
# buffer files only; the times the app shows follow Settings -> General.
# Defaults to UTC if unset. Full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Media isolation: FFmpeg, ffprobe and MediaMTX run as a separate user inside the container, so a camera
# stream that takes one over cannot read the database or the secrets. ON by default. Default: blank, which means
# "try it": on a host that cannot do it (rootless Docker/Podman, a share that ignores chmod, NFS root_squash,
# PUID or PGID 1700, PUID=0, missing capabilities) the container starts the old way and logs one warning.
# Range: 0, off or false (any capitals) turns it off; anything else, blank included, leaves it on. Read at
# start, so re-create the container after a change. New recordings are then owned by uid 1700 (existing ones
# keep their owner). See docs/operations.md, "Media isolation".
NIGHTLIGHT_MEDIA_ISOLATION=

# Optional - a random, persistent secret is auto-generated and stored in your data
# volume (private/.jwt_secret) on first run if this is left blank. Only set this yourself if you
# specifically need a fixed value (e.g. restoring a data volume onto a fresh install
# and want the same secret, though your existing sessions would need to log in again
# either way since the secret only affects newly-issued sessions).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional - which upstream addresses may set X-Forwarded-For. Leave blank unless you run
# Nightlight behind a reverse proxy AND that proxy connects from something other than
# 127.0.0.1 (SWAG reaching it by LAN IP is the common case - see docs/remote-access.md).
#
# Set it to the address your proxy connects FROM, e.g. TRUST_PROXY=10.0.0.20. Accepts an IP
# or CIDR, a comma-separated list, a hop count (1), or a named range.
#
# WARNING: only trust an address you control. Whatever you list here is allowed to declare a
# client IP, so too broad a value - or the word "true", which trusts every upstream - lets
# anyone forge X-Forwarded-For and evade the login rate limit entirely. Leaving it blank is
# safe: login attempts are already limited per account as well as per source.
#
# A value Nightlight cannot make sense of is IGNORED with a warning in the log, and the safe
# default is used instead - it will not stop the app starting.
TRUST_PROXY=

# Optional - how many days a sign-in lasts, counted from sign-in (not from last use; there is
# no idle sign-out). Range 7-30 whole days. Blank = 30 (the default). Anything else is ignored
# with a warning in the log and 30 is used.
#
# WARNING: a phone is signed out at the same time of day it signed in, this many days later,
# and from then until someone opens the app it gets NO Nightlight push alerts (Pushover, ntfy
# and Gotify are not affected). Lowering this signs out every sign-in older than the new value
# at its next request; raising it does not lengthen sign-ins already made (a sign-in made at 7
# still ends on its 7th day). See SECURITY.md, "How long a sign-in lasts".
SESSION_TTL_DAYS=

# Optional - Cloudflare Web Analytics. If you do NOT use Cloudflare Web Analytics, leave this
# blank: nothing changes.
#
# If you serve Nightlight through Cloudflare's proxy with Web Analytics turned on, Cloudflare
# injects its beacon script into every page, and Nightlight's Content-Security-Policy BLOCKS it
# unless this is on (the browser console shows a violation, and the log shows [csp-report]
# lines, at most 10 a minute). Set it to 1, true, yes or on (any case) to allow the beacon, or,
# if you do not want those analytics, turn off Web Analytics' automatic setup for the site in
# the Cloudflare dashboard. Blank (the default), 0, false, no or off keep it blocked; any other
# value also keeps it blocked, with one warning in the log at start. Until this setting existed
# the beacon was allowed on every install: if you rely on it, set this when you upgrade.
CLOUDFLARE_ANALYTICS=

# Where the app's data (the database and secrets, in its private/ folder; snapshots; clips unless
# CLIPS_DIR below says otherwise) is stored on the host. Logs go to `docker logs`, not here.
# Defaults to ./data if unset. On Unraid, set this to something like
# /mnt/user/appdata/nightlight so it shows up in the Unraid UI and gets picked up
# by your normal appdata backup routine.
APPDATA_DIR=./data

# Optional - which port the app listens on. Defaults to 4000 if unset. Under host
# networking (the default in docker-compose.yml) this directly changes the port you
# reach it on, e.g. http://<host>:4001. Useful mainly if 4000 is already taken, or
# you're running two instances host-networked on the same machine (see
# "Running more than one instance" in docs/networking.md - they need different ports either way).
PORT=

# Optional - move event-recording clips off the same disk as the database (e.g. onto
# spinning-disk array storage instead of an SSD cache). Leave both of these blank to
# keep clips under the data directory above (the default).
#   1. Uncomment the "recordings" volume line in docker-compose.yml and point it at
#      a host path, e.g. /mnt/user/nightlight-clips:/recordings
#   2. Set CLIPS_DIR to the container-side path you mounted it at, e.g. /recordings
#      (absolute; a trailing slash is fine; blank = unset)
# The host folder must be writable by PUID/PGID, or clip recording is disabled; see docs/recording.md#where-recordings-are-stored.
# Retention caps (Settings -> Recording) protect disk usage either way.
CLIPS_DIR=

# Your public IP or (better) a DDNS hostname, only needed for Low Latency (WebRTC)
# mode to work from outside your home network. Leave blank for LAN-only use, or if
# you're fine relying on Compatibility mode remotely. See
# "Remote / internet access" in docs/remote-access.md before setting this.
PUBLIC_HOST=
# PUBLIC_HOST must be your public IP or a DNS-only hostname. A Cloudflare-proxied (orange
# cloud) name cannot carry the UDP media, so remote Low Latency would never connect.

# Optional - the UDP port Low Latency (WebRTC) video travels on. A bare number between 1
# and 65535, no colon. Blank = 8189 (the default). Change it only to run a second instance
# on the same host (e.g. staging beside production): give each instance its own port and
# forward that same number on your router 1:1 (the port in and out must match).
# An invalid value is ignored with a warning in the log and 8189 is used instead.
WEBRTC_UDP_PORT=

# Optional - the STUN servers Low Latency (WebRTC) uses, in the browser AND in the bundled
# MediaMTX (and the browser is allowed to reach exactly these, no others). A comma-separated
# list of stun:host or stun:host:port. STUN only matters to viewers OUTSIDE your home network
# who are behind NAT; viewing on your own network never needs it.
#   - Default (the line below, or removing the variable entirely): Google's public server.
#     It learns each viewer's public IP address and when each live view connected.
#   - Blank (STUN_SERVERS=) : NO STUN server. Nothing contacts Google or anyone else.
#   - Your own list, e.g. STUN_SERVERS=stun:stun.example.org:3478
# An entry that is not a stun: URL is ignored with ONE warning in the log. If none is valid,
# STUN is off (never silently back to Google). turn: and stuns: URLs are not supported.
STUN_SERVERS=stun:stun.l.google.com:19302
